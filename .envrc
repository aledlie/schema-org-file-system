# Export OBTOOL_API_KEY for the OTEL export scripts (.claude/scripts/otel/).
# doppler_get reads the dotfiles Doppler cache (integrity-studio/dev). direnv
# evaluates .envrc with /bin/bash 3.2, where the cache loader is skipped
# (needs bash 4+), so fall back to a direct Doppler CLI read.
source "$HOME/dotfiles/shell/doppler-secrets.sh" 2>/dev/null || true
export OBTOOL_API_KEY=$(doppler_get OBTOOL_API_KEY 2>/dev/null)
if [ -z "$OBTOOL_API_KEY" ]; then
  export OBTOOL_API_KEY=$(doppler secrets get OBTOOL_API_KEY --plain -p integrity-studio -c dev)
fi
