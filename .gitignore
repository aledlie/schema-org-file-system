# Claude Code
.claude/settings.local.json
.claude/py-cache/
.cache/

# Repomix
repomix-output.xml
docs/repomix/*

# Claude Code local/transient state (tracked config under .claude/ stays visible)
.claude/worktrees/                 # session worktrees (never tracked)
.claude/hooks/                     # local hook tooling: own node_modules/dist/package-lock, nothing tracked here
.claude/scheduled_tasks.lock       # session scheduler lock
.claude/**/.claude/                # nested .claude dirs from running claude in subdirectories
